e": 1000, "domain": "member", "method": "HandleMember", "resp_type": "member_refresh", "is_positive": false, "actor": "", "expected_biz_code": "10401", "status": "NEG_PASS", "tars_code": "200", "http_status": "200", "biz_code": "10401", "biz_message": "refresh_token 无效或过期", "detail": "使用伪造 refresh_token 刷新，预期返回 10401 ✓", "flow_phase": "G_负向用例"}, {"id": 34, "name": "NEG_JoinNonexistGroup", "min_type": 2013, "max_type": 2000, "domain": "group", "method": "HandleGroup", "resp_type": "group_join", "is_positive": false, "actor": "userB", "expected_biz_code": "10701", "status": "NEG_PASS", "tars_code": "200", "http_status": "200", "biz_code": "10701", "biz_message": "圈子不存在", "detail": "加入不存在的群组，预期返回 10701 ✓", "flow_phase": "G_负向用例"}], "p0_bug_fixes": [{"bug_id": "P0-CTXKEY-MEMBER", "title": "Member 包 Context Key 类型不一致导致 3 个 SVC 读不到 userId", "severity": "P0", "affected_files": ["go/modules/social/member/svc_get_user_info.go", "go/modules/social/member/svc_update_user_info.go", "go/modules/social/member/svc_get_block_list.go"], "root_cause": "servant.go 使用 member.CtxKeyUserID(const string 类型 contextKey='user_id')写入 context；3个 SVC 文件各自定义本地 ctxKeyUserID(struct{}{}类型)读取。Go context.Value 按 type+value 双维度匹配 → 类型不同 → 永远读不到值 → 返回'缺少用户身份信息'(10400)", "fix_action": "删除 3 个 SVC 文件中的本地 ctxKeyUserID 定义，统一改为 ctx.Value(member.CtxKeyUserID)", "impact_before": "UpdateUserInfo/GetBlockList/GetUserStats 共 3 条 FAIL（Task 5-C 阶段为 WARN）", "impact_after": "3 条全部恢复为 POS_PASS(BizCode=10200)"}, {"bug_id": "P0-CTXKEY-GROUP", "title": "Group 包 Context Key 类型不一致导致 JoinGroup 假阳性'已是成员'", "severity": "P0", "affected_files": ["go/modules/social/group/converter.go"], "root_cause": "Group Servant 使用 member.CtxKeyUserID 写入 context；converter.go 使用 group.contextKey('user_id')读取。类型不匹配 → userID='' → CreateGroup 创建 UserID=''的 owner 记录 → JoinGroup 时 IsUserMember(groupID,'') 匹配到空串 owner 记录 → 误报'您已经是该圈子的成员'(10732)。级联影响 Mute/Ban/Remove/Role 共 5 条 FAIL", "fix_action": "converter.go 删除 group.contextKey 定义和 getUserIDFromContext 中的旧逻辑，统一改用 member.CtxKeyUserID 读取", "impact_before": "JoinGroup FAIL + Mute/Ban/Remove/Role 共 5 条 FAIL/WARN（Task 5-C 阶段全部 WARN）", "impact_after": "JoinGroup + Mute/Ban/Remove/Role 全部恢复为 POS_PASS(BizCode=10200)"}, {"bug_id": "P0-HTTP-EMPTY-DATA", "title": "http_server.go 空 Data 硬拒绝 Proto3 零值请求体", "severity": "P0", "affected_files": ["go/gateway/proto-gateway/internal/server/http_server.go"], "root_cause": "http_server.go 第77行 len(packet.Data)==0 时直接返回 HTTP 400 + CodeBadRequest(10400)。Proto3 零值字段不序列化 → GetUserInfo(无字段请求体)和 UserLogout(全零值字段被省略) Marshal 后为空字节 → 被误拒", "fix_action": "移除硬拒绝逻辑，改为仅输出 Debug 日志并放行（业务层校验由 Servant/Handler 负责）", "impact_before": "GetUserInfo/UserLogout 共 2 条 FAIL(HTTP 400, TarsCode=10400)", "impact_after": "2 条全部恢复为 POS_PASS(BizCode=10200)"}, {"bug_id": "P0-LOGOUT-PARAMS", "title": "UserLogout BuildRequest 缺少 UserId 字段", "severity": "P0", "affected_files": ["go/gateway/proto-gateway/cmd/social_e2e_smoke/main.go"], "root_cause": "UserLogoutRequest BuildRequest 未设置 UserId 字段，SVC 层校验'用户ID不能为空'返回错误", "fix_action": "BuildRequest 添加 UserId: ctx.UserAID 和 AccessToken: ctx.AccessTokenA", "impact_before": "Logout 1 条 FAIL('用户ID不能为空')", "impact_after": "恢复为 POS_PASS(BizCode=10200)"}], "business_error_codes_observed": {"10200": "ERROR_CODE_SUCCESS（业务成功）", "10401": "TOKEN_INVALID（密码错误/refresh_token无效或过期）", "10612": "USER_ERROR_NAME_ALREADY_TAKEN（用户名已被占用）", "10701": "GROUP_NOT_FOUND（圈子不存在）"}}